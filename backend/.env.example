# Copy this file to .env and fill in real values for local development.
# Never commit a real .env file.

# Local dev default uses SQLite so `docker compose up` / pytest work with
# zero setup. In docker-compose and production, this is overridden to
# point at the postgres service / managed database.
DATABASE_URL=postgresql+psycopg2://dqp_user:dqp_password@localhost:5432/dqp

CORS_ORIGINS=http://localhost:5173

MAX_UPLOAD_SIZE=10485760

REPORTS_DIR=./reports

LOG_LEVEL=INFO
